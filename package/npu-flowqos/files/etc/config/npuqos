config npuqos 'main'
	option enabled '1'
	# 出口/下行带宽标定 (Mbit/s)，0 = 不限/不整形（纯分档模式）
	option bw_eth0 '0'
	option bw_wwan '0'
	option bw_eth0_down '0'
	option bw_wwan_down '0'

